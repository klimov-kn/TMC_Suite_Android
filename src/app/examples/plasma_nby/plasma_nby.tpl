#TMC_RT_H
! ==========================================================================
! Ћ–2: волновод с квадратиком замагниченной плазмы (X-мода, €дро tmc_rtx.exe)
! Ќебольшой квадрат плазмы (сторона s) в центре волновода + магнитное поле B0
! в той же области = замагниченна€ (гиротропна€) плазма. —мотрим прохождение
! волны. ѕорт 1 активный, порт 2 пассивный. ќдин шаг на частоте F.
!
! ¬ј∆Ќќ (по опыту отладки):
!  * Ќачинайте с режима fp < F (плазма "разрежЄнна€", волна ѕ–ќ’ќƒ»“, счЄт
!    устойчив). «десь Ne=1.1e+17 даЄт fp~3 √√ц при F=5 √√ц.
!  * –ежим fp = F (напр. Ne=3.1e+17 при F=5) Ч плазменный резонанс (эффективна€
!    eps -> 0), счЄт на грани устойчивости; включайте его только после того, как
!    убедились, что разрежЄнный случай считаетс€.
!  *  вадрат (RECT_STAT_N) надЄжнее круга.  руг: CIRCLE_STAT_N Ne; 0; Rp; 0; 6.28;
!    (Ќ≈ ставьте ровно 2*PI Ч из-за округлени€ сектор может "схлопнутьс€").
!  * ¬ окне статистики блок RECT_STAT_N показывает nType=0 и пустые координаты Ч
!    это Ќќ–ћјЋ№Ќќ (тип eps=0; окно не умеет показывать блоки с суффиксом _N/_B).
!    ѕровер€йте не координаты, а строку трассировки "Set block 20; points:N" Ч
!    N должно быть > 0 (значит квадрат лЄг на сетку).
! ==========================================================================
#define a   @ ( 60.0 )
#define d   @ (  1.0 )
#define F   @ (  5.0 )     ! частота сигнала, √√ц           (ѕќ ¬ј–»јЌ“”)
#define s   @ ( 2*a/3 )     ! сторона квадратика плазмы, мм  (ѕќ ¬ј–»јЌ“”)
#define Ne  @ ( 1.24e+18 )  ! концентраци€ электронов, 1/м^3 (fp~3 √√ц < F; знак + об€зателен!)
#define B0  @ ( 0.2 )
#define Yl  @ ( 0.1 )    ! магнитное поле, “л             (fc~2 √√ц)
#define L   @ ( 4*a )
#define W   @ ( 4*a/3 )
#define ylo @ ( (W-a)/2 )
#define yhi @ ( (W+a)/2 )
#define xl  @ ( L/2-s/2 )  ! лева€ граница квадрата
#define xr  @ ( L/2+s/2 )  ! права€ граница
#define yd  @ ( W/2-s/2 )  ! нижн€€ граница
#define yu  @ ( W/2+s/2 )  ! верхн€€ граница
#define PI  @ ( 3.141592653589 )

! ===== STEP: FREQ = 10 GHz =====
#STEP
#PARM
 ANGLE_UNIT radian;
 FREQ_UNIT  GHz;
 LONG_UNIT  mm;
 TIME_UNIT  ns;
 DELTA  d;
 TIME   0.; 115.0;
 X_MIN  0.0;
 X_MAX  L;
 Y_MIN  0.0;
 Y_MAX  W;
 FREQ   10;
#END_PARM

#TOPOLOGY
 BLOCK 1;
  RECT_STAT METAL; 0; L; ylo-d; ylo;      ! нижн€€ стенка
 END_B
 BLOCK 2;
  RECT_STAT METAL; 0; L; yhi; yhi+d;      ! верхн€€ стенка
 END_B
 BLOCK 20;
  RECT_STAT_N Ne; xl; xr; yd; yu;         ! квадрат плазмы: концентраци€ электронов Ne
 END_B
 BLOCK 21;
  RECT_STAT_B B0; xl; xr; yd; yu;         ! B
 END_B
 BLOCK 22;
  RECT_STAT_Y Yl; xl; xr; yd; yu;         ! магнитное поле B0 в той же области
 END_B
 BLOCK 7;
  INPUT_X ; ylo; yhi; 0; 115; 1; 0;       ! активный порт (слева)
 END_B
 BLOCK 12;
  INPUT_X ; ylo; yhi; 300; 400; 0; 0;     ! пассивный порт (справа)
 END_B
#END_TOPOLOGY

#LINK_LIST
 T 1;  0.0; 0.0;
 T 2;  0.0; 0.0;
 T 20; 0.0; 0.0;
 T 21; 0.0; 0.0;
 T 22; 0.0; 0.0;
 T 7;  0.0; 0.0;
 T 12; L;   0.0;
#END_LINK

#OUTPUT
 FILE plasma;
 SMATRIX plasma; 10; 100.0; 110.0;
#END_OUTPUT
#END_STEP

#EOF
