# ============================================================
#  TMC Suite for Android - .gitattributes
# ============================================================
# The computational sources keep the encoding and line endings of the Windows
# edition (CP1251, CRLF). Line-ending normalisation is disabled repository-wide
# so that every file round-trips byte for byte, exactly as it was compiled.

* -text

# --- Explicitly binary: never diff or merge as text ---
*.png   binary
*.jpg   binary
*.ico   binary
*.ttf   binary
*.apk   binary
*.aab   binary
