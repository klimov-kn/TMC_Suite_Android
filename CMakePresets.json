{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "QT_ROOT": "C:/Qt/6.11.1",
        "QT_TOOLS": "C:/Qt/Tools"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "$env{QT_TOOLS}/Ninja/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Linux, g++ (отладка интерфейса и ядер без телефона)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$penv{HOME}/Qt/6.11.1/gcc_64",
        "CMAKE_MAKE_PROGRAM": "ninja"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (API 28+)",
      "inherits": "base",
      "toolchainFile": "$env{QT_ROOT}/android_arm64_v8a/lib/cmake/Qt6/qt.toolchain.cmake",
      "environment": {
        "ANDROID_SDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk",
        "ANDROID_NDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk/ndk/27.2.12479018"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QT_HOST_PATH": "$env{QT_ROOT}/mingw_64",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "QT_ANDROID_ABIS": "arm64-v8a",
        "QT_ANDROID_BUILD_ALL_ABIS": "OFF"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a, выпуск: APK и AAB",
      "inherits": "android-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "kernels-android-arm64",
      "displayName": "Ядра tmc_rth и tmc_rtx: Android arm64-v8a (API 28)",
      "description": "Только src/kernels, без Qt: ядра для запуска через adb.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/kernels-android",
      "environment": {
        "ANDROID_NDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk/ndk/27.2.12479018"
      },
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TAMIC_KERNELS_ONLY": "ON",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_static",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": [
        "apk"
      ]
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release",
      "targets": [
        "aab"
      ]
    },
    {
      "name": "kernels-android-arm64",
      "configurePreset": "kernels-android-arm64"
    }
  ]
}
